#!/usr/bin/env bash
set -euo pipefail

REAL_GIT="/usr/bin/git"

if [ ! -x "$REAL_GIT" ]; then
  echo "git guard error: real git binary not found at $REAL_GIT" >&2
  exit 127
fi

if [ "$#" -eq 0 ]; then
  exec "$REAL_GIT"
fi

args=("$@")
cmd=""
i=0

while [ "$i" -lt "$#" ]; do
  arg="${args[$i]}"

  case "$arg" in
    -C|--git-dir|--work-tree|--namespace|--exec-path|--config-env)
      i=$((i + 2))
      continue
      ;;
    -c)
      i=$((i + 2))
      continue
      ;;
    --*)
      i=$((i + 1))
      continue
      ;;
    -*)
      i=$((i + 1))
      continue
      ;;
    *)
      cmd="$arg"
      break
      ;;
  esac
done

case "$cmd" in
  add|am|apply|bisect|branch|checkout|cherry-pick|clean|commit|fetch|gc|init|merge|mv|pull|push|rebase|reset|restore|revert|rm|stash|submodule|switch|tag|worktree)
    echo "Blocked git command inside AI sandbox: git $cmd" >&2
    echo "Run this Git operation from your host shell instead." >&2
    exit 126
    ;;
esac

exec "$REAL_GIT" "$@"